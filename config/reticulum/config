# Reticulum config for zknode-autonomi-alpha
# Post-quantum mesh networking stack integrated with Katzenpost mixnet
# Format: RNS 1.3.x (zeros/reticulum:arm64 image). Interfaces MUST live
# under [interfaces] with an explicit type = key.

[reticulum]
  enable_transport = true
  share_instance = true
  panic_on_interface_error = false

[logging]
  loglevel = 4

[interfaces]

  # TCP server — allows other Reticulum nodes on the local network
  # or through the mixnet proxy to connect
  [[Reticulum TCP Server]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 0.0.0.0
    listen_port = 37428

  # Client mode for the above TCP server (route through the mixnet SOCKS5
  # proxy for metadata-private Reticulum P2P traffic). Uncomment when proxy
  # is fully operational:
  # [[Mixnet SOCKS5 Client]]
  #   type = TCPClientInterface
  #   enabled = no
  #   target_host = 127.0.0.1
  #   target_port = 1080
  #   proxy = socks5h://127.0.0.1:1080

  # Local Ethernet/WiFi auto-discovery
  [[Auto Interface]]
    type = AutoInterface
    enabled = yes

  # LoRa RNode interface — Heltec LoRa32 v4 (SX1262), 915 MHz
  # Long-range, low-power wireless mesh via Reticulum
  # To switch to 868 MHz: rnodeconf --freq 868000000 /dev/ttyACM0
  # (or change frequency below and restart the container)
  [[RNode LoRa Interface]]
    type = RNodeInterface
    enabled = yes
    port = /dev/ttyACM0
    speed = 115200
    frequency = 915000000
    bandwidth = 125000
    txpower = 22
    spreadingfactor = 7
    codingrate = 5