#!/usr/bin/env python3
"""NomadNet dynamic page: search P4P wiki via dashboard API"""
import http.client, urllib.parse, json, os, sys

DASH_HOST = "127.0.0.1"
DASH_PORT = 8080

def api_post(path, body):
    conn = http.client.HTTPConnection(DASH_HOST, DASH_PORT, timeout=15)
    data = json.dumps(body).encode()
    conn.request("POST", path, body=data, headers={"Content-Type": "application/json"})
    resp = conn.getresponse()
    raw = resp.read().decode()
    conn.close()
    return json.loads(raw)

q = os.environ.get("QUERY_STRING", "").strip()
params = urllib.parse.parse_qs(q)
query = params.get("q", [""])[0]

print("# Wiki Search")
if not query:
    print()
    print("Usage: add ?q=search+terms to the URL")
    print()
    print("[Back to Wiki|/wiki/index.mu]")
    sys.exit(0)

print(f"Search results for: {query}")
print()

try:
    data = api_post("/api/wiki/search", {"query": query, "topK": 20})
    results = data.get("results", []) if isinstance(data, dict) else []
except Exception as e:
    results = []
    print(f"Search error: {e}")

if not results:
    print("No results found.")
    print()
else:
    for r in results:
        title = r.get("title") or r.get("slug", "").split("/")[-1].replace("-", " ").replace("_", " ")
        uri = r.get("uri") or r.get("slug", "")
        uri_clean = uri.replace("wiki://p4p/wiki/", "").replace("wiki://p4p/", "")
        slug_param = urllib.parse.quote(uri_clean, safe="")
        print(f"  [{title}|/wiki/page?slug={slug_param}]")

print()
print("[New Search|/wiki/search.mu]")
print("[Wiki Home|/wiki/index.mu]")
