# zknode-autonomi environment variables
# Copy to .env and fill in. Every variable the compose stack consumes is
# listed here — compose fails fast on bare ${VAR} without a value.

# ─── Image names (build with ./scripts/build.sh; override for GHCR mirrors) ───
# Arch-agnostic: for a single-arch host, suffix or retag as you prefer —
# compose only needs A name present in the local/remote docker cache.
IMAGE_MIXNET=zeros/mixnet-node:arm64
IMAGE_MIXNET_PROXY=zeros/mixnet-proxy:arm64
IMAGE_ANT_NODE=zeros/ant-node:arm64
IMAGE_ANTD=zeros/antd:arm64
IMAGE_STORAGE_PROVED=zeros/storage-proved-rs:arm64
IMAGE_WALLETSHIELD=zeros/walletshield:arm64
IMAGE_DASHBOARD=zknode-dashboard:latest

# ─── Ports ───
DASHBOARD_PORT=8080
WS_PORT=9200
LLM_WIKI_PORT=18765
ANT_NODE_PORT=12000
PROXY_SOCKS_PORT=1080

# ─── Resource limits (compose mem_limit) ───
MIXNET_MEM_LIMIT=256m
PROXY_MEM_LIMIT=256m

# ─── Autonomi ───
AUTONOMI_EVM_NETWORK=arbitrum-sepolia
# HSM deployments: set ANT_REWARDS_ADDRESS instead of SECRET_KEY
# ANT_REWARDS_ADDRESS=
# SECRET_KEY=
AUTONOMI_CHUNK_DB=/mnt/autonomi/autonomi/chunks
AUTONOMI_LOGS_DIR=/mnt/autonomi/autonomi/logs

# ─── Host layout ───
# Host path of the deployment root (dashboard docker mounts resolve on the host)
NODE_HOME=/home/<node-user>/zknode-autonomi

# ─── Dashboard security ───
# UNSET (default) = fail-safe: dashboard binds 127.0.0.1 ONLY.
# Set a strong random token to allow LAN access: the UI prompts for it and
# all /api endpoints are authenticated (rate-limited).
# generate: openssl rand -hex 24
# DASHBOARD_TOKEN=
# Optional explicit bind (defaults: 127.0.0.1 without token, 0.0.0.0 with)
# DASHBOARD_BIND=
