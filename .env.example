# zknode-autonomi environment variables
# Copy to .env and fill in

# Dashboard port (default: 8080)
DASHBOARD_PORT=8080

# Autonomi EVM network (optional)
AUTONOMI_EVM_NETWORK=mainnet

# ZSCM HSM (optional — for attestation and key sealing)
# ZSCM_PORT=8765

# Host path of the deployment root (dashboard docker mounts resolve on the host)
NODE_HOME=/home/<node-user>/zknode-autonomi
