# zknode-autonomi environment variables
# Copy to .env and fill in
#
# Portable USB mode: set ZK_ROOT to the USB drive mount point
# (e.g. ZK_ROOT=/mnt/zknode). usb-init.sh generates this file on the
# target host. If ZK_ROOT is unset, the compose file directory is used.

# ─── Portable base ─────────────────────────────────────────
# Root of the node data on the host. All compose paths derive from this.
# On the SCM4: /home/zero-tech/zknode-autonomi
# On a portable USB drive: <drive mount>, e.g. /mnt/zknode
ZK_ROOT=/home/zero-tech/zknode-autonomi

# Vendored host binaries (chatd, zkchat, llm-wiki, ant). Filled by usb-prep.sh.
#ZK_BIN=${ZK_ROOT}/bin

# Wiki data set (llm-wiki articles). Filled by usb-prep.sh.
#ZK_WIKIS=${ZK_ROOT}/wikis

# Persisted llm-wiki state
#ZK_LLM_WIKI_HOME=${ZK_ROOT}/.llm-wiki

# antd node data + chunks (bulk storage)
#ZK_ANT_DIR=${ZK_ROOT}/data/antd
#ZK_ANT_NODE=${ZK_ROOT}/data/ant-node
#AUTONOMI_CHUNK_DB=${ZK_ROOT}/data/chunks

# USB pool (or any large external store); default /mnt/autonomi on SCM4
#ZK_POOL=/mnt/autonomi

# ─── Images ─────────────────────────────────────────────────
# Arch suffix: arm64 on SCM4/RPi, amd64 on x86_64 targets.
# usb-init.sh sets these from the vendored image set for the detected arch.
IMAGE_MIXNET=zeros/mixnet-node:arm64
IMAGE_MIXNET_PROXY=zeros/mixnet-proxy:arm64
IMAGE_ANTD=zeros/antd:arm64
IMAGE_DASHBOARD=zknode-dashboard:latest
IMAGE_WALLETSHIELD=ws-deploy:latest
IMAGE_RETICULUM=zeros/reticulum:arm64
IMAGE_STORAGE_PROVED=zeros/storage-proved-rs:arm64

# ─── Memory limits (MB) ─────────────────────────────────────
MIXNET_MEM_LIMIT=256m
PROXY_MEM_LIMIT=256m

# ─── Ports (all tunable on foreign hosts) ───────────────────
DASHBOARD_PORT=8080
LLM_WIKI_PORT=18765
WS_PORT=9200
WALLETSHIELD_PORT=9200
STORAGE_PROVED_PORT=9201
ANTD_PORT=12000

# NOTE: mixnet ports 30001-30019 and gateway 64332 are fixed by the
# baked PKI doc (config/mixnet/auth1/authority.toml). To change them,
# regenerate configs with scripts/gen-mixnet-configs.sh.

# ─── Autonomi EVM network (optional) ────────────────────────
AUTONOMI_EVM_NETWORK=mainnet

# antd node flags (defaults match the live SCM4 testnet deployment)
#ANT_NETWORK_MODE=testnet
#ANT_EVM_NETWORK=arbitrum-sepolia

# walletshield upstream RPC
#WALLETSHIELD_UPSTREAM=https://ethereum-rpc.publicnode.com

# Autonomi rewards address (only used by antd)
#ANT_REWARDS_ADDRESS=0x0000000000000000000000000000000000000000

# ZSCM HSM (optional — for attestation and key sealing)
# ZSCM_PORT=8765
