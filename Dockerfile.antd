ARG TARGETARCH=arm64
ARG BUILDER_ARCH=amd64

FROM --platform=linux/${BUILDER_ARCH} rust:latest AS builder

ARG AUTONOMI_BRANCH=main

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    clang \
    lld \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    && dpkg --add-architecture arm64 \
    && apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev:arm64 \
    liblzma-dev:arm64 \
    zlib1g-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add aarch64-unknown-linux-gnu

# Configure cargo for aarch64 cross-compilation
RUN mkdir -p /root/.cargo && cat > /root/.cargo/config.toml << 'EOF'
[target.aarch64-unknown-linux-gnu]
linker = "aarch64-linux-gnu-gcc"
ar = "aarch64-linux-gnu-ar"
EOF

# ant-client is a workspace with ant-core + ant-cli
RUN git clone --branch ${AUTONOMI_BRANCH} --depth 1 \
    https://github.com/WithAutonomi/ant-client.git /src/ant-client

RUN cd /src/ant-client && \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC=aarch64-linux-gnu-gcc \
    CXX=aarch64-linux-gnu-g++ \
    AR=aarch64-linux-gnu-ar \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
    cargo build --release --target aarch64-unknown-linux-gnu --bin ant

FROM --platform=linux/${TARGETARCH} arm64v8/debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    liblzma5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/ant-client/target/aarch64-unknown-linux-gnu/release/ant /usr/local/bin/

RUN mkdir -p /var/lib/antd

ENTRYPOINT ["ant"]
CMD ["--help"]
