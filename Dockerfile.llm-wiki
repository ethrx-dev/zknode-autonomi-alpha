ARG TARGETARCH=arm64

FROM --platform=linux/${TARGETARCH} rust:1.84-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev libgit2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone https://github.com/geronimo-iia/llm-wiki.git . && \
    cargo build --release --bin llm-wiki && \
    cp target/release/llm-wiki /usr/local/bin/llm-wiki

FROM --platform=linux/${TARGETARCH} debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/llm-wiki /usr/local/bin/llm-wiki

RUN mkdir -p /var/lib/llm-wiki /var/log/llm-wiki

EXPOSE 18765

VOLUME ["/var/lib/llm-wiki"]

ENTRYPOINT ["/usr/local/bin/llm-wiki"]
CMD ["serve", "--http", "0.0.0.0:18765", "--wiki-root", "/var/lib/llm-wiki"]
