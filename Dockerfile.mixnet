ARG TARGETARCH=arm64
ARG BUILDER_ARCH=amd64

FROM --platform=linux/${BUILDER_ARCH} golang:latest AS builder

ARG TARGETARCH=arm64

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libsnappy-dev \
    liblz4-dev \
    libzstd-dev \
    zlib1g-dev \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    && dpkg --add-architecture arm64 \
    && apt-get update && apt-get install -y --no-install-recommends \
    libsnappy-dev:arm64 \
    liblz4-dev:arm64 \
    libzstd-dev:arm64 \
    zlib1g-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

# Build RocksDB for aarch64 (cross-compile)
RUN cd /tmp \
    && git clone --branch v10.2.1 --depth 1 https://github.com/facebook/rocksdb.git \
    && cd rocksdb \
    && PORTABLE=1 make -j"$(nproc)" shared_lib \
       CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ \
       AR=aarch64-linux-gnu-ar \
       EXTRA_CFLAGS="-O2" EXTRA_CXXFLAGS="-O2" \
       LDFLAGS="-L/usr/aarch64-linux-gnu/lib" \
    && cp -a librocksdb.so* /usr/local/lib/ \
    && cp -a include/* /usr/local/include/ \
    && cd /tmp && rm -rf rocksdb

# Build Katzenpost components (Go cross-compile to arm64)
COPY katzenpost /src/katzenpost

# Katzenpost core/log exports Backend but some code expects Logger; add type alias
RUN printf '\n// Alias for backward compatibility\ntype Logger = logging.Logger\n' \
    >> /src/katzenpost/core/log/log.go

RUN mkdir /dest && \
    cd /src/katzenpost && \
    export GOOS=linux GOARCH=arm64 CGO_ENABLED=1 \
           CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ \
           CGO_CFLAGS="-I/usr/local/include -I/usr/include" \
           CGO_LDFLAGS="-L/usr/local/lib -L/usr/lib/aarch64-linux-gnu -lrocksdb -lsnappy -llz4 -lzstd -lz" && \
     for cmd in dirauth server courier kpclientd ping fetch echo-plugin genconfig http-proxy-server http-proxy-client; do \
         cd /src/katzenpost/cmd/$cmd && \
         go build -trimpath -ldflags="-buildid=" -o /dest/$cmd . && \
         echo "  built $cmd"; \
     done

FROM --platform=linux/${TARGETARCH} arm64v8/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libsnappy1v5 \
    liblz4-1 \
    libzstd1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/librocksdb.so* /usr/local/lib/
COPY --from=builder /dest/* /usr/local/bin/

RUN ldconfig
