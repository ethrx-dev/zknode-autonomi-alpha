ARG TARGETARCH=arm64

FROM --platform=linux/${TARGETARCH} python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    rns \
    lxmf \
    nomadnet

RUN mkdir -p /etc/reticulum /var/lib/reticulum /var/log/reticulum

EXPOSE 37428/udp 4242/tcp

VOLUME ["/var/lib/reticulum"]

ENTRYPOINT ["rnsd"]
CMD ["--config", "/etc/reticulum/config"]
