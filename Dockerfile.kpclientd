ARG TARGETARCH=arm64
ARG BUILDER_ARCH=amd64

FROM --platform=linux/${BUILDER_ARCH} golang:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
    git patch \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY katzenpost /src/katzenpost
COPY patches/fix-decoy-sender-nil-pointer.patch /tmp/

RUN cd /src/katzenpost && patch -p1 < /tmp/fix-decoy-sender-nil-pointer.patch

RUN cd /src/katzenpost/cmd/kpclientd && \
    go mod edit -replace github.com/katzenpost/katzenpost=/src/katzenpost && \
    GOOS=linux GOARCH=arm64 CGO_ENABLED=1 \
    CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ \
    go build -trimpath -ldflags="-buildid=" -o /dest/kpclientd .

FROM --platform=linux/${TARGETARCH} alpine:latest

COPY --from=builder /dest/kpclientd /usr/local/bin/

ENTRYPOINT ["kpclientd"]
CMD ["--help"]
