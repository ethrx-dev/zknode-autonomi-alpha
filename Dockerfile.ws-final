FROM --platform=linux/arm64 golang:latest AS builder
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential pkg-config && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/ZeroKnowledgeNetwork/opt.git /opt
COPY main.go /opt/apps/walletshield/main.go
COPY thin /opt/apps/walletshield/thin
WORKDIR /opt/apps/walletshield
RUN go build -trimpath -o /dest/walletshield .
FROM debian:stable-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libc6 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /dest/walletshield /walletshield
EXPOSE 9200
ENTRYPOINT ["/walletshield"]
CMD ["-h"]
