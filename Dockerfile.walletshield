ARG TARGETARCH=arm64

FROM --platform=linux/${TARGETARCH} arm64v8/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY walletshield-fix/walletshield-arm64 /usr/local/bin/walletshield

EXPOSE 9200

ENTRYPOINT ["walletshield"]
CMD ["-h"]
