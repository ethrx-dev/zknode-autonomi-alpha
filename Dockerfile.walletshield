ARG TARGETARCH=arm64
ARG BUILDER_ARCH=amd64

FROM --platform=linux/${BUILDER_ARCH} golang:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    git \
    && rm -rf /var/lib/apt/lists/*

# Clone ZKNetwork/opt for dependencies (go.mod/go.sum)
RUN git clone --depth 1 https://github.com/ZeroKnowledgeNetwork/opt.git /src/opt

# Override walletshield main.go with our fixed version
COPY walletshield-fix/main.go /src/opt/apps/walletshield/main.go

# Copy forked thin client package to fix isConnected tracking
COPY walletshield-fix/thin /src/opt/apps/walletshield/thin

RUN cd /src/opt/apps/walletshield && \
    GOOS=linux GOARCH=arm64 CGO_ENABLED=1 \
    CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ \
    go build -trimpath -ldflags="-buildid=" -o /dest/walletshield .

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /dest/walletshield /walletshield

EXPOSE 9200

ENTRYPOINT ["/walletshield"]
CMD ["-h"]
